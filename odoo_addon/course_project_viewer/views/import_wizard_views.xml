<odoo>
  <record id="view_course_project_import_wizard_form" model="ir.ui.view">
    <field name="name">course_project.import_wizard.form</field>
    <field name="model">course_project.import_wizard</field>
    <field name="arch" type="xml">
      <form string="Import Position">
        <p>
          Paste the backend URL of your CV Manager instance and the API
          token generated on the position's page (Position → API token
          → Generate).
        </p>
        <group>
          <field name="backend_url"/>
          <field name="api_token" password="True"/>
        </group>
        <footer>
          <button name="action_import" type="object" string="Import"
                  class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_course_project_import_wizard" model="ir.actions.act_window">
    <field name="name">Import Position</field>
    <field name="res_model">course_project.import_wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
